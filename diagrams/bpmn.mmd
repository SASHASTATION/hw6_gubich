---
title: 'BPMN — Расчёт кредитного скора физлица и обратная связь (текстовое представление)'
---
flowchart LR
  subgraph U[Клиент]
    s((Старт)) --> u[Подать заявку и согласие]
  end
  subgraph C[Кредитный конвейер]
    c[Запросить кредитный скор]
    r[Получить результат скоринга] --> gr{Какой статус?}
    gr -->|OK| e0((Скор рассчитан))
    gr -->|INVALID_REQUEST| e1((Некорректный запрос))
    gr -->|DATA_UNAVAILABLE| e2((Недоступны данные))
    gr -->|MODEL_ERROR| e3((Ошибка модели))
  end
  subgraph O[Оркестратор скоринга]
    o[Проверить согласие и запрос] --> g0{Запрос допустим?}
    g0 -->|Нет| badreq[Подготовить INVALID_REQUEST]
    g{Статус ответа ML API?} -->|Данные| baddata[Подготовить DATA_UNAVAILABLE]
    g -->|Ошибка| badml[Подготовить MODEL_ERROR]
    g -->|OK| ok[Подготовить скор и метаданные]
    badreq --> j{Слияние}
    baddata --> j
    badml --> j
    ok --> j
    j --> audit[Записать результат или ошибку в журнал] --> ga{Запись успешна?}
    ga -->|Нет| tech[Вернуть техническую ошибку без скора] --> e4((AUDIT_ERROR))
    ga -->|Да| ret[Передать скор или MANUAL_REVIEW]
  end
  subgraph M[ML API]
    m[Собрать признаки и рассчитать PD / скор]
  end
  subgraph D[Пайплайн данных — независимая обратная связь]
    fs((Получен исход заявки)) --> fg{Кредит выдан?}
    fg -->|Нет| fn[Сохранить исход без метки дефолта] --> fe0((Исход сохранён))
    fg -->|Да| fw[Получить события погашения за 12 мес.] --> fl[Сформировать метку или исключить запись] --> fe1((Данные обработаны))
  end
  u --> c --> o
  g0 -->|Да| m --> g
  ret --> r
  classDef failure fill:#fee2e2,stroke:#b91c1c,stroke-width:4px,color:#991b1b;
  classDef success fill:#e2f4e7,stroke:#267047,stroke-width:4px,color:#267047;
  class e1,e2,e3,e4 failure;
  class e0,fe0,fe1 success;
