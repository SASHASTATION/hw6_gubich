<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Search" targetNamespace="https://example.org/yandex-go-search-ml">
  <bpmn:process id="Process_Search" name="Прогноз времени назначения водителя" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="U" name="Пассажир / приложение Яндекс Go">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="O" name="Оркестратор прогноза">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ML" name="ML API">
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Заказ начат">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u1" name="Оформить заказ">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="b1" name="Запустить поиск водителя">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="m" name="Рассчитать прогноз">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="Прогноз пригоден?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b2" name="Подготовить таймер">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="b3" name="Подготовить статус без таймера">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j" name="Слияние">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b4" name="Отправить состояние поиска">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u2" name="Получить таймер или статус">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="b5" name="Получить итог поиска">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="b6" name="Записать прогноз и исход">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u3" name="Получить итог поиска">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Итог получен">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="u1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="u1" targetRef="b1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="b1" targetRef="m"/>
    <bpmn:sequenceFlow id="f3" sourceRef="m" targetRef="g"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g" targetRef="b2" name="Да"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g" targetRef="b3" name="Нет"/>
    <bpmn:sequenceFlow id="f6" sourceRef="b2" targetRef="j"/>
    <bpmn:sequenceFlow id="f7" sourceRef="b3" targetRef="j"/>
    <bpmn:sequenceFlow id="f8" sourceRef="j" targetRef="b4"/>
    <bpmn:sequenceFlow id="f9" sourceRef="b4" targetRef="u2"/>
    <bpmn:sequenceFlow id="f10" sourceRef="u2" targetRef="b5"/>
    <bpmn:sequenceFlow id="f11" sourceRef="b5" targetRef="b6"/>
    <bpmn:sequenceFlow id="f12" sourceRef="b6" targetRef="u3"/>
    <bpmn:sequenceFlow id="f13" sourceRef="u3" targetRef="e"/>
    <bpmn:textAnnotation id="feedback">
      <bpmn:text>Kafka → история → обучение: order_id, snapshot_id, версия, назначение / отмена, время исхода.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_feedback" sourceRef="b6" targetRef="feedback" associationDirection="None"/>
  </bpmn:process>
