<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Scoring" targetNamespace="https://example.org/sber-credit-scoring">
  <bpmn:message id="Msg_Outcome" name="Исход кредитной заявки"/>
  <bpmn:process id="Process_Scoring" name="Расчёт кредитного скора физлица и обратная связь" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="U" name="Клиент">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="C" name="Кредитный конвейер">
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="O" name="Оркестратор скоринга">
        <bpmn:flowNodeRef>o</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>badreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>baddata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>badml</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="M" name="ML API">
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="D" name="Пайплайн данных">
        <bpmn:flowNodeRef>fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fe0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fe1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Старт">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u" name="Подать заявку и согласие">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="c" name="Запросить кредитный скор">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="o" name="Проверить согласие и запрос">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g0" name="Запрос допустим?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m" name="Собрать признаки и рассчитать PD / скор">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="Статус ответа ML API?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="badreq" name="Подготовить статус INVALID_REQUEST">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="baddata" name="Подготовить статус DATA_UNAVAILABLE">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="badml" name="Подготовить статус MODEL_ERROR">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ok" name="Подготовить скор и метаданные (OK)">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="audit" name="Записать результат или ошибку в журнал">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ga" name="Запись успешна?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="tech" name="Вернуть техническую ошибку без скора">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e4" name="Ошибка записи AUDIT_ERROR">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ret" name="Передать скор или MANUAL_REVIEW">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r" name="Получить результат скоринга">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gr" name="Какой статус?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Скор рассчитан (OK)">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e1" name="Некорректный запрос / нет согласия INVALID_REQUEST">
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Недоступны обязательные данные DATA_UNAVAILABLE">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Ошибка модели / тайм-аут / ответ MODEL_ERROR">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="fs" name="Получен исход заявки (асинхронно)">
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Outcome" messageRef="Msg_Outcome"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="fg" name="Кредит выдан?">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="fn" name="Сохранить исход без метки дефолта">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fe0" name="Исход сохранён">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="fw" name="Получить события погашения за 12 мес.">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="fl" name="Сформировать метку или исключить запись">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fe1" name="Данные обработаны">
      <bpmn:incoming>f30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="u"/>
    <bpmn:sequenceFlow id="f1" sourceRef="u" targetRef="c"/>
    <bpmn:sequenceFlow id="f2" sourceRef="c" targetRef="o"/>
    <bpmn:sequenceFlow id="f3" sourceRef="o" targetRef="g0"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g0" targetRef="badreq" name="Нет"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g0" targetRef="m" name="Да"/>
    <bpmn:sequenceFlow id="f6" sourceRef="m" targetRef="g"/>
    <bpmn:sequenceFlow id="f7" sourceRef="g" targetRef="baddata" name="Данные"/>
    <bpmn:sequenceFlow id="f8" sourceRef="g" targetRef="badml" name="Ошибка"/>
    <bpmn:sequenceFlow id="f9" sourceRef="g" targetRef="ok" name="OK"/>
    <bpmn:sequenceFlow id="f10" sourceRef="badreq" targetRef="j"/>
    <bpmn:sequenceFlow id="f11" sourceRef="baddata" targetRef="j"/>
    <bpmn:sequenceFlow id="f12" sourceRef="badml" targetRef="j"/>
    <bpmn:sequenceFlow id="f13" sourceRef="ok" targetRef="j"/>
    <bpmn:sequenceFlow id="f14" sourceRef="j" targetRef="audit"/>
    <bpmn:sequenceFlow id="f15" sourceRef="audit" targetRef="ga"/>
    <bpmn:sequenceFlow id="f16" sourceRef="ga" targetRef="tech" name="Нет"/>
    <bpmn:sequenceFlow id="f17" sourceRef="tech" targetRef="e4"/>
    <bpmn:sequenceFlow id="f18" sourceRef="ga" targetRef="ret" name="Да"/>
    <bpmn:sequenceFlow id="f19" sourceRef="ret" targetRef="r"/>
    <bpmn:sequenceFlow id="f20" sourceRef="r" targetRef="gr"/>
    <bpmn:sequenceFlow id="f21" sourceRef="gr" targetRef="e0" name="OK"/>
    <bpmn:sequenceFlow id="f22" sourceRef="gr" targetRef="e1" name="Запрос"/>
    <bpmn:sequenceFlow id="f23" sourceRef="gr" targetRef="e2" name="Данные"/>
    <bpmn:sequenceFlow id="f24" sourceRef="gr" targetRef="e3" name="Модель"/>
    <bpmn:sequenceFlow id="f25" sourceRef="fs" targetRef="fg"/>
    <bpmn:sequenceFlow id="f26" sourceRef="fg" targetRef="fn" name="Нет"/>
    <bpmn:sequenceFlow id="f27" sourceRef="fn" targetRef="fe0"/>
    <bpmn:sequenceFlow id="f28" sourceRef="fg" targetRef="fw" name="Да"/>
    <bpmn:sequenceFlow id="f29" sourceRef="fw" targetRef="fl"/>
    <bpmn:sequenceFlow id="f30" sourceRef="fl" targetRef="fe1"/>
    <bpmn:textAnnotation id="feedback">
      <bpmn:text>90+ DPD за 12 месяцев; нет снимка или неполное наблюдение — исключить. Датасет → обучение и валидация.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_feedback" sourceRef="fl" targetRef="feedback" associationDirection="None"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Scoring" name="BPMN — Расчёт кредитного скора и обратная связь">
    <bpmndi:BPMNPlane id="Plane_Scoring" bpmnElement="Process_Scoring">
